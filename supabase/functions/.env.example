# Secret untuk Edge Function submit-wish.
# Produksi: `npx supabase secrets set --env-file supabase/functions/.env`
# (SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY sudah otomatis tersedia di Supabase.)

# Cloudflare Turnstile secret. Test key (selalu lolos) untuk dev:
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# String acak panjang, untuk hash IP (IP mentah tidak pernah disimpan).
IP_HASH_SALT=ganti-dengan-string-acak-panjang
# Origin yang boleh memanggil function (pisahkan dengan koma).
ALLOWED_ORIGINS=http://localhost:4321,https://undangan.example.com
