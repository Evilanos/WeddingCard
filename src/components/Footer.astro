---
import { event } from '../config/event';

const [first, second] = event.coupleOrder.map((k) => event[k].panggilan);
---

<footer class="bg-ink px-6 pb-28 pt-16 text-center text-paper">
  <div class="mx-auto max-w-md" data-reveal>
    <p class="text-sm leading-relaxed text-paper/80">{event.footer.penutup}</p>
    <p class="mt-6 font-serif italic text-sm text-gold-soft">“May the Lord bless you and keep you.”</p>
    <p class="mt-8 text-xs uppercase tracking-[0.3em] text-gold-soft">{event.footer.salam}</p>
    <p class="mt-2 font-script text-5xl">{first} &amp; {second}</p>
  </div>
</footer>
